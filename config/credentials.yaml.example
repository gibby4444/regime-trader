# Copy to config/credentials.yaml and fill in. Never commit the real file.
# Environment variables in .env take precedence over values here.

alpaca:
  api_key: your_key_here
  secret_key: your_secret_here
  paper: true

alerts:
  email:
    smtp_host: smtp.example.com
    smtp_port: 587
    username: alerts@example.com
    password: your_smtp_password
    from_addr: alerts@example.com
    to_addrs: [you@example.com]
  webhook:
    # e.g. Slack/Discord incoming webhook URL
    url: https://hooks.example.com/your/webhook
